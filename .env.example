# Copy to .env locally; .env is ignored. Use existing compatible installations.
CONDA_EXE=/path/to/miniconda3/bin/conda
ISAACSIM_ENV=/path/to/conda_envs/isaacsim
FOUNDATIONPOSE_ENV=/path/to/conda_envs/foundationpose
# Optional: defaults are repository-relative third_party directories.
# FOUNDATIONPOSE_ROOT=/path/to/FoundationPose
# ISAAC_ROS_WS=/path/to/IsaacSim-ros_workspaces/humble_ws
# ROS_SETUP=/opt/ros/humble/setup.bash
# ROS_PYTHON=/usr/bin/python3
# ISAAC_ROS_BRIDGE_LIB=/path/to/isaacsim/exts/isaacsim.ros2.bridge/humble/lib
# FOUNDATIONPOSE_PYTHON is optional for legacy helper scripts only.
