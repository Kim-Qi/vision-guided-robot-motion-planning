<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">
  <xacro:arg name="initial_positions_file" default="$(find moveit_resources_panda_moveit_config)/config/initial_positions.yaml"/>
  <xacro:include filename="$(find moveit_resources_panda_description)/urdf/panda.urdf"/>
  <xacro:include filename="$(find moveit_resources_panda_moveit_config)/config/panda.ros2_control.xacro"/>
  <xacro:panda_ros2_control name="PandaSystem" initial_positions_file="$(arg initial_positions_file)" ros2_control_hardware_type="isaac"/>
  <!-- Separate command stream prevents the arm and hand publishers from replacing
       each other's JointState packet on a single per-tick subscriber. The USD
       already enforces joint2 mimic; only its driver receives a command. -->
  <ros2_control name="PandaHandSystem" type="system">
    <hardware>
      <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
      <param name="joint_commands_topic">isaac_gripper_commands</param>
      <param name="joint_states_topic">isaac_joint_states</param>
    </hardware>
    <joint name="panda_finger_joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
